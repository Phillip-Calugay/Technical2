# Rename this file to .env before uploading it to InfinityFree.
CI_ENVIRONMENT = production

app.baseURL = 'https://your-subdomain.infinityfreeapp.com/'

# Copy the exact values from InfinityFree Control Panel > MySQL Databases.
database.default.hostname = sql###.infinityfree.com
database.default.database = epiz_########_your_database
database.default.username = epiz_########
database.default.password = replace-with-your-infinityfree-password
database.default.DBDriver = MySQLi
database.default.port = 3306
